---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Karte from '../../components/Karte.svelte';
import Quellen from '../../components/Quellen.astro';
import KeinAmt from '../../components/KeinAmt.astro';
import { kantonKarte, KARTEN_QUELLE } from '../../lib/karte';
import { KANTONE, KANTONSDATEN, SPRACHEN, gemeindenVon, GEMEINDEN_QUELLE, GEMEINDEN_STICHTAG, type Kanton } from '../../lib/kantone';
import { pfad } from '../../lib/site';

export function getStaticPaths() {
  return KANTONE.map((k) => ({ params: { kt: k.code.toLowerCase() }, props: { kanton: k } }));
}
const { kanton } = Astro.props as { kanton: Kanton };
const karte = kantonKarte(kanton.nr);
const gemeinden = gemeindenVon(kanton.code).sort((a, b) => a.name.localeCompare(b.name, 'de-CH'));
const lektionen = await getCollection('lektionen', (l) => l.data.kanton === kanton.code);
const f = KANTONSDATEN.felder;
const ungeprueft = (feld: string) => (f[feld]?.ungeprueft ? '' : undefined);
---
<Basis titel={`Kanton ${kanton.name}`} beschreibung={`Kanton ${kanton.name} (${kanton.code}): Hauptort, Beitritt, Amtssprachen und alle ${gemeinden.length} Gemeinden auf der Karte.`} bereich="kantone">
  <header class="seite-kopf">
    <ol class="sd-breadcrumb" aria-label="Pfad"><li><a href={pfad()}>Start</a></li><li><a href={pfad('kantone')}>Kantone</a></li><li><span aria-current="page">{kanton.name}</span></li></ol>
    <h1 class="seite-titel">Kanton {kanton.name}</h1>
    <p class="seite-lede">{kanton.code} · Kanton Nr. {kanton.nr} · {gemeinden.length} Gemeinden</p>
  </header>
  <div class="uebersicht">
    <div class="zweispaltig">
      <Karte client:visible {...karte} titel={`Gemeinden im Kanton ${kanton.name}`} einheit="Gemeinde" ueben={gemeinden.length > 3} />
      <dl class="fakten">
        <div><dt>Hauptort</dt><dd data-ungeprueft={ungeprueft('hauptort')}>{kanton.hauptort}</dd></div>
        <div><dt>Beitritt</dt><dd data-ungeprueft={ungeprueft('beitritt')}>{kanton.beitritt}</dd></div>
        <div><dt>Amtssprachen</dt><dd data-ungeprueft={ungeprueft('sprachen')}>{kanton.sprachen.map((s) => SPRACHEN[s]).join(', ')}</dd></div>
        <div><dt>Gemeinden</dt><dd>{gemeinden.length} (Stand {GEMEINDEN_STICHTAG.replaceAll('-', '.')})</dd></div>
        {kanton.hinweis && <div><dt>Hinweis</dt><dd>{kanton.hinweis}</dd></div>}
      </dl>
    </div>
    {lektionen.length > 0 && (
      <section>
        <h2>Lektionen zum Kanton {kanton.name}</h2>
        <ul class="lektionen">
          {lektionen.map((l) => <li><a href={pfad(l.id)}><strong>{l.data.titel}</strong><span>{l.data.beschreibung}</span></a></li>)}
        </ul>
      </section>
    )}
    <section>
      <h2>Alle Gemeinden</h2>
      <ul class="gemeindeliste">{gemeinden.map((g) => <li>{g.name}</li>)}</ul>
    </section>
    <div class="seite-fuss">
      <Quellen quellen={[...Object.values(KANTONSDATEN.quellen).filter((q) => q.url !== GEMEINDEN_QUELLE), { titel: 'BFS, Amtliches Gemeindeverzeichnis (Daten)', url: GEMEINDEN_QUELLE }, KARTEN_QUELLE]} />
      <KeinAmt />
    </div>
  </div>
</Basis>
