---
import Basis from '../layouts/Basis.astro';
import Icon from '../components/Icon.astro';
import Karte from '../components/Karte.svelte';
import { schweizKarte } from '../lib/karte';
import { KANTONE, GEMEINDEN } from '../lib/kantone';
import { pfad } from '../lib/site';

const karte = schweizKarte();
const flaechen = karte.flaechen.map((f) => {
  const k = KANTONE[f.id - 1];
  return { ...f, href: pfad(`kantone/${k.code.toLowerCase()}`), info: `Hauptort ${k.hauptort} · seit ${k.beitritt}` };
});
const bereiche = [
  { href: 'kantone', icon: 'map-pin', titel: 'Kantone', text: `Alle 26 Kantone und ${GEMEINDEN.length} Gemeinden auf der Karte, mit Hauptort, Sprachen und Geschichte.` },
  { href: 'politik', icon: 'landmark', titel: 'Politisches System', text: 'Bund, Kantone und Gemeinden, direkte Demokratie, Parlament und Bundesrat.' },
  { href: 'einbuergerung', icon: 'book-open', titel: 'Einbürgerung', text: 'Voraussetzungen, Ablauf und Grundkenntnistest, zuerst für den Kanton Zürich.' },
];
---
<Basis titel="meinCH" beschreibung="Die Schweiz verstehen: Kantone, Gemeinden, politisches System und Vorbereitung auf die Einbürgerung.">
  <header class="start-kopf">
    <div class="sd-meta"><span>Neutral, werbefrei, mit Quellen</span></div>
    <h1 class="start-titel">Die Schweiz verstehen, nicht nur den Test bestehen</h1>
    <p class="seite-lede">meinCH erklärt die Schweiz von der Gemeinde bis zum Bund: interaktive Karten, das politische System und alles, was du für die Einbürgerung wissen musst. Jede Aussage mit Quelle und Prüfdatum.</p>
  </header>
  <div class="uebersicht">
    <Karte client:visible {...karte} flaechen={flaechen} titel="Die 26 Kantone" ueben />
    <div class="bereiche">
      {bereiche.map((b) => (
        <a class="bereich" href={pfad(b.href)}>
          <span class="bereich__titel"><Icon name={b.icon} />{b.titel}</span>
          <span class="bereich__text">{b.text}</span>
        </a>
      ))}
    </div>
  </div>
</Basis>
