---
/** Lucide icon from the vendored SteinerDesign assets, coloured with currentColor via CSS mask. */
import { datei } from '../lib/site';
interface Props { name: string; class?: string }
const { name, class: klasse = 'sd-icon' } = Astro.props;
const url = datei(`vendor/steinerdesign/assets/icons/${name}.svg`);
---
<span class={`icon ${klasse}`} aria-hidden="true" style={`--icon-url: url("${url}")`}></span>
